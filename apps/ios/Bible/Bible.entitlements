<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iCloud Documents for the Study Library folder (issue #22). The container must also be
  enabled on the App ID `dev.bible-rs.ios` in the Apple Developer portal:
  Identifiers → App IDs → Bible → iCloud → iCloud Documents, with container
  `iCloud.dev.bible-rs.ios`. Until that is done, device builds that sign with this
  entitlement will fail; simulator and unsigned CI builds do not need it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.bible-rs.ios</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dev.bible-rs.ios</string>
	</array>
</dict>
</plist>
